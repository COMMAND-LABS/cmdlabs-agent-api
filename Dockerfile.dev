FROM python:3.12-slim

RUN apt-get update && apt-get install -y curl git build-essential libpq-dev zlib1g-dev

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /code

# Copy project so "pip install ." can build and install deps (including langgraph-supervisor)
COPY ./README.md ./
COPY ./pyproject.toml ./
COPY ./src ./src
RUN uv pip install --system --no-cache . \
    && uv pip install --system --no-cache "langgraph-supervisor>=0.0.31"

ENV PYTHONPATH=/code
